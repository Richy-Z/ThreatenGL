{
  "schemaVersion": 1,

  "id": "maxgl",
  "version": "${version}",

  "name": "MaxGL",
  "description": "Forces Minecraft to use OpenGL 4.6. Fork of ThreatenGL updated for Minecraft 26.1.",

  "authors": [
    {
      "name": "Plexescor"
    },
    {
      "name": "Richy Z. (original ThreatenGL)",
      "contact": {
        "homepage": "https://richy.lol"
      }
    }
  ],

  "contact": {
    "homepage": "https://modrinth.com/mod/maxgl",
    "sources": "https://github.com/Plexescor/MaxGL",
    "issues": "https://github.com/Plexescor/MaxGL/issues"
  },

  "license": "LGPL-3.0-only",
  "icon": "threatengl-icon-notext-128.png",

  "environment": "client",
  "entrypoints": {
    "main": [
      "lol.richy.threatengl.fabric.ThreatenGLFabric"
    ],
    "client": [
      "lol.richy.threatengl.fabric.client.ThreatenGLFabricClient"
    ]
  },
  "mixins": [
    "threatengl.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.18.5",
    "minecraft": "26.1",
    "java": ">=25"
  }
}